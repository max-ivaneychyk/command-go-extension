  "scripts": {
    "start": "export BROWSER='chrome' && node utils/server.js",
    "start:ff": "export BROWSER='firefox' && node utils/server.js",
    "build": "export BROWSER='chrome' && node utils/build.js",
    "build:ff": "export BROWSER='firefox' && node utils/build.js",
    "css": "tailwindcss -i ./src/app/index.css -o src/app/output.css --watch",
    "css:build": "tailwindcss -i ./src/app/index.css -o src/app/output.css",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md}'"
  },
